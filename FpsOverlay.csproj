<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only needed for the tray icon and menu (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FpsOverlay</RootNamespace>
    <AssemblyName>FpsOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.1.0</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Product>FPS Overlay</Product>
    <!-- DPI is set in the manifest, which is right for WPF; the warning concerns WinForms windows -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads ETW Present events (DXGI / D3D9 / DxgKrnl) to count FPS -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
  </ItemGroup>

</Project>
