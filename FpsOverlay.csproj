<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для иконки в трее (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FpsOverlay</RootNamespace>
    <AssemblyName>FpsOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.1</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Product>FPS Overlay</Product>
    <!-- DPI задаём в манифесте — это правильно для WPF; предупреждение относится к WinForms-окнам -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Чтение ETW-событий Present (DXGI / D3D9 / DxgKrnl) для подсчёта FPS -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
  </ItemGroup>

</Project>
